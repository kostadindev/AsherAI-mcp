{
  "name": "trialrun-mcp",
  "version": "0.2.0",
  "description": "An MCP gateway that assesses data stewardship and AI-literacy habits while any MCP agent works on your files.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "trialrun-mcp": "dist/bin/server.js",
    "trialrun-policy": "dist/bin/policy.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node dist/bin/server.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "accuracy": "tsx accuracy/score.ts",
    "corpus": "tsx accuracy/corpus-src.ts && tsx accuracy/corpus-heldout-v1-src.ts && tsx accuracy/corpus-heldout-v2-src.ts && tsx accuracy/corpus-heldout-v3-src.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-literacy",
    "data-protection",
    "assessment",
    "education",
    "claude",
    "gateway",
    "privacy",
    "pii-detection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kostadindev/trialrun-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kostadindev/trialrun-mcp/issues"
  },
  "homepage": "https://github.com/kostadindev/trialrun-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
